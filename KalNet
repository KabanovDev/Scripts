local skeletonUpdateCounter = 0
local SKELETON_UPDATE_RATE = 3

RunService.RenderStepped:Connect(function(dt)
    if fovCircle then
        if State.Aimbot then
            fovCircle.Visible = true
            fovCircle.Position = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
            fovCircle.Radius = State.AimbotFOV
        else
            fovCircle.Visible = false
        end
    end

    if State.Spin and player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local angle = math.rad(State.SpinSpeed) * dt
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0)
        end
    end

    skeletonUpdateCounter = skeletonUpdateCounter + 1
    local shouldUpdate = skeletonUpdateCounter >= SKELETON_UPDATE_RATE

    for _, data in ipairs(espLabels) do
        local plr = data.plr
        local gui = data.gui
        local isTeam = State.ESPTeamCheck and isSameTeam(plr)

        if plr and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChildOfClass("Humanoid") and not isTeam then
            local head = plr.Character.Head
            local humanoid = plr.Character.Humanoid
            gui.Adornee = head

            if State.ESP then
                local showAny = false
                local infoText = ""
                if State.ShowNames then
                    data.name.Text = plr.Name
                    data.name.Visible = true
                    showAny = true
                else
                    data.name.Visible = false
                end
                if State.ShowHealth then
                    infoText = math.floor(humanoid.Health) .. " HP"
                end
                if State.ShowDistance then
                    if infoText ~= "" then infoText = infoText .. " | " end
                    infoText = infoText .. math.floor((head.Position - camera.CFrame.Position).Magnitude) .. "m"
                end
                data.info.Text = infoText
                data.info.Visible = infoText ~= ""
                if infoText ~= "" then showAny = true end
                gui.Enabled = showAny
            else
                gui.Enabled = false
            end

            for _, o in ipairs(outlineHighlights) do
                if o.plr == plr then
                    if State.ESP and State.OutlineGlow and not isTeam then
                        o.highlight.Adornee = plr.Character
                        o.highlight.Enabled = true
                    else
                        o.highlight.Enabled = false
                    end
                end
            end

            if State.ESP and State.ShowSkeleton and not isTeam then
                if shouldUpdate then drawSkeletonForPlayer(plr) end
            else
                if skeletonDrawings[plr] then clearSkeletonForPlayer(plr) end
            end
        else
            gui.Enabled = false
            for _, o in ipairs(outlineHighlights) do
                if o.plr == plr then o.highlight.Enabled = false end
            end
            if skeletonDrawings[plr] then clearSkeletonForPlayer(plr) end
        end
    end

    if shouldUpdate then skeletonUpdateCounter = 0 end
    if not State.ESP or not State.ShowSkeleton then clearAllSkeletons() end
end)

UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 and State.Aimbot then
        if Connections.Aimbot then Connections.Aimbot:Disconnect() end
        Connections.Aimbot = RunService.RenderStepped:Connect(function()
            local closest, closestDist = nil, State.AimbotFOV
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChildOfClass("Humanoid") and plr.Character.Humanoid.Health > 0 then
                    if not (State.AimbotTeamCheck and isSameTeam(plr)) then
                        local tp = plr.Character:FindFirstChild(State.AimbotTargetPart) or plr.Character:FindFirstChild("Head")
                        if tp then
                            local sp, on = camera:WorldToViewportPoint(tp.Position)
                            if on then
                                local dist = (Vector2.new(sp.X, sp.Y) - Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)).Magnitude
                                if dist < closestDist then
                                    if State.AimbotObstacleCheck then
                                        local ray = Ray.new(camera.CFrame.Position, (tp.Position - camera.CFrame.Position).Unit * 1000)
                                        local hit = workspace:FindPartOnRay(ray, player.Character)
                                        if hit and hit:IsDescendantOf(plr.Character) then
                                            closestDist = dist
                                            closest = tp
                                        end
                                    else
                                        closestDist = dist
                                        closest = tp
                                    end
                                end
                            end
                        end
                    end
                end
            end
            if closest then
                if State.AimSmoothness <= 1 then
                    camera.CFrame = CFrame.new(camera.CFrame.Position, closest.Position)
                else
                    local lookAt = CFrame.lookAt(camera.CFrame.Position, closest.Position)
                    camera.CFrame = camera.CFrame:Lerp(lookAt, 1 / State.AimSmoothness)
                end
            end
        end)
    end
end)

