UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.F then
        if isFullyReset then
            isFullyReset = false
        end
        
        isEnabled = not isEnabled
        
        if isEnabled then
            statusText = "Starting..."
            targetLoop()
            checkRespawn()
            startTeleportLoop()
        else
            statusText = "Off"
            currentTarget = nil
            stopAutoClicker()
            
            if targetCoroutine then
                coroutine.close(targetCoroutine)
                targetCoroutine = nil
            end
            
            if respawnCheckCoroutine then
