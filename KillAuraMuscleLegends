local function getStrength(player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then return 0 end
    local strength = leaderstats:FindFirstChild("Strength")
    if not strength then return 0 end
    return strength.Value
end

local function getPlayerHealth(player)
    local character = player.Character
    if not character then return 0 end
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return 0 end
    return humanoid.Health
end

local function getWeakerPlayers()
    local myStrength = getStrength(LocalPlayer)
    local weakerPlayers = {}
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character and character:FindFirstChild("Humanoid") and character:FindFirstChild("HumanoidRootPart") then
                local strength = getStrength(player)
                if strength < myStrength then
                    table.insert(weakerPlayers, {
                        player = player,
                        strength = strength
                    })
                end
            end
        end
    end
    
    table.sort(weakerPlayers, function(a, b)
        return a.strength < b.strength
    end)
    
    return weakerPlayers
end

local function teleportToPlayer(targetPlayer)
    if not targetPlayer then return false end
    
    local character = targetPlayer.Character
    if not character then return false end
    
    local targetRoot = character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return false end
    
    local myCharacter = LocalPlayer.Character
    if not myCharacter then return false end
    
    local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end
    
    local targetPos = targetRoot.Position + TELEPORT_OFFSET
    myRoot.CFrame = CFrame.new(targetPos)
    
    return true
end

local function findToolByName()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return nil end
    
    for _, tool in pairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.Name == TOOL_NAME then
            return tool
        end
    end
    
    local character = LocalPlayer.Character
    if character then
        for _, tool in pairs(character:GetChildren()) do
            if tool:IsA("Tool") and tool.Name == TOOL_NAME then
                return tool
            end
        end
    end
    
    return nil
end

local function equipTool()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local tool = findToolByName()
    if not tool then return nil end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end
    
    local currentTool = character:FindFirstChildOfClass("Tool")
    if currentTool and currentTool == tool then
        return tool
    end
    
    pcall(function()
        humanoid:EquipTool(tool)
    end)
    
    task.wait(0.2)
    return tool
end

local function clickTool(tool)
    if not tool then return false end
    
    local clicked = false
    
    pcall(function()
        tool:Activate()
        clicked = true
    end)
    
    if not clicked then
        local clickEvent = tool:FindFirstChild("ClickEvent")
        if clickEvent then
            pcall(function()
                clickEvent:FireServer()
                clicked = true
            end)
        end
    end
    
    if not clicked then
        local remote = tool:FindFirstChild("RemoteEvent")
        if remote then
            pcall(function()
                remote:FireServer()
                clicked = true
            end)
        end
    end
    
    if not clicked then
        local remoteFunc = tool:FindFirstChild("RemoteFunction")
        if remoteFunc then
            pcall(function()
                remoteFunc:InvokeServer()
                clicked = true
            end)
        end
    end
    
    return clicked
end

local function startAutoClicker(tool)
    if not tool then return end
    
    isClicking = true
    currentTool = tool
    
    if clickCoroutine then
        coroutine.close(clickCoroutine)
        clickCoroutine = nil
    end
    
    clickCoroutine = coroutine.create(function()
        while isEnabled and isClicking and currentTool do
            if not currentTool.Parent or currentTool.Parent ~= LocalPlayer.Character then
                local newTool = equipTool()
                if newTool then
                    currentTool = newTool
                else
                    break
                end
            end
            
            clickTool(currentTool)
            task.wait(CLICK_INTERVAL)
        end
    end)
    
    coroutine.resume(clickCoroutine)
end

local function stopAutoClicker()
    isClicking = false
    currentTool = nil
    
    if clickCoroutine then
        coroutine.close(clickCoroutine)
        clickCoroutine = nil
    end
end

local function startTeleportLoop()
    if teleportCoroutine then
        coroutine.close(teleportCoroutine)
        teleportCoroutine = nil
    end
    
    teleportCoroutine = coroutine.create(function()
        while isEnabled do
            if currentTarget then
                local health = getPlayerHealth(currentTarget)
                if health > 0 and currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart") then
                    teleportToPlayer(currentTarget)
                end
            end
            task.wait(TELEPORT_INTERVAL)
        end
    end)
    
    coroutine.resume(teleportCoroutine)
end

local function checkRespawn()
    if respawnCheckCoroutine then
        coroutine.close(respawnCheckCoroutine)
        respawnCheckCoroutine = nil
    end
    
    respawnCheckCoroutine = coroutine.create(function()
        local wasDead = false
        
        while isEnabled do
            local currentChar = LocalPlayer.Character
            
            if not currentChar or not currentChar:FindFirstChild("Humanoid") or currentChar.Humanoid.Health <= 0 then
                if not wasDead then
                    wasDead = true
                    statusText = "Respawning..."
                    stopAutoClicker()
                end
            else
                if wasDead then
                    wasDead = false
                    statusText = "Respawned, re-equipping..."
                    
                    task.wait(0.5)
                    
                    if isEnabled then
                        local tool = equipTool()
                        if tool then
                            startAutoClicker(tool)
                            statusText = "Tool equipped: " .. tool.Name
                        else
                            statusText = "Tool not found: " .. TOOL_NAME
                        end
                    end
                end
            end
            
            task.wait(0.2)
        end
    end)
    
    coroutine.resume(respawnCheckCoroutine)
end

local function targetLoop()
    if targetCoroutine then
        coroutine.close(targetCoroutine)
        targetCoroutine = nil
    end
    
    targetCoroutine = coroutine.create(function()
        local weakerPlayers = {}
        local lastUpdateTime = 0
        local targetIndex = 1
        local currentTargetPlayer = nil
        local targetStartTime = 0
        
        while isEnabled do
            local myChar = LocalPlayer.Character
            if not myChar or not myChar:FindFirstChild("Humanoid") or myChar.Humanoid.Health <= 0 then
                task.wait(0.2)
                continue
            end
            
            if tick() - lastUpdateTime > CHECK_INTERVAL then
                weakerPlayers = getWeakerPlayers()
                lastUpdateTime = tick()
                
                if #weakerPlayers == 0 then
                    statusText = "No weak players"
                    currentTarget = nil
                    currentTargetPlayer = nil
                    
                    if isClicking then
                        stopAutoClicker()
                    end
                    
                    task.wait(1)
                    continue
                end
            end
            
            if #weakerPlayers > 0 then
                if targetIndex > #weakerPlayers then
                    targetIndex = 1
                end
                
                local targetData = weakerPlayers[targetIndex]
                local target = targetData.player
                local health = getPlayerHealth(target)
                
                if health > 0 and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    if currentTargetPlayer ~= target then
                        currentTargetPlayer = target
                        targetStartTime = tick()
                        targetTimer = 0
                    end
                    
                    targetTimer = tick() - targetStartTime
                    
                    if targetTimer < MAX_TARGET_TIME then
                        currentTarget = target
                        local strength = getStrength(target)
                        statusText = target.Name .. " | HP: " .. math.floor(health) .. " | STR: " .. strength .. " | Time: " .. string.format("%.1f", targetTimer) .. "s"
                        
                        if not isClicking then
                            local tool = equipTool()
                            if tool then
                                startAutoClicker(tool)
                            else
                                statusText = "Tool not found: " .. TOOL_NAME
                            end
                        end
                        
                        task.wait(0.1)
                    else
                        statusText = "Target timeout, switching..."
                        targetIndex = targetIndex + 1
                        currentTargetPlayer = nil
                        targetTimer = 0
                        
                        if targetIndex > #weakerPlayers then
                            targetIndex = 1
                        end
                        
                        task.wait(0.1)
                    end
                else
                    statusText = "Target dead, switching..."
                    targetIndex = targetIndex + 1
                    currentTargetPlayer = nil
                    targetTimer = 0
                    
                    if targetIndex > #weakerPlayers then
                        targetIndex = 1
                    end
                    
                    if isClicking then
                        stopAutoClicker()
                    end
                    
                    task.wait(0.05)
                end
            end
            
            task.wait(0.1)
        end
    end)
    
    coroutine.resume(targetCoroutine)
end

local function resetAll()
    print("=== RESETTING AUTO HUNTER ===")
    
    isEnabled = false
    isClicking = false
    currentTarget = nil
    currentTool = nil
    statusText = "Reset"
